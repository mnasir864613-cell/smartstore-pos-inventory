# ============================================================
# Root-level .gitignore — SmartStore POS & Inventory System
# ============================================================

# --- Secrets: NEVER commit these ---
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.env.local
.env.*.local

# --- Dependencies ---
node_modules/
**/node_modules/

# --- Build outputs ---
dist/
**/dist/
build/
**/build/

# --- IDE / Editor metadata (auto-generated, not project files) ---
*.metadata.json
**/*.metadata.json
.vscode/
.idea/
*.swp
*.swo

# --- OS artifacts ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Test coverage ---
coverage/
**/coverage/

# --- Misc ---
.nyc_output
*.tsbuildinfo
