# SmartStore POS Frontend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# All Vite env vars exposed to the browser MUST start with VITE_

# API Base URL
# Same-origin deployment (frontend served from same domain as backend):
#   VITE_API_BASE_URL=/api
# Cross-origin deployment (frontend on different domain than backend):
#   VITE_API_BASE_URL=https://your-backend-domain.com/api
VITE_API_BASE_URL=/api

# App name (optional — used for display purposes)
VITE_APP_NAME=SmartStore POS
