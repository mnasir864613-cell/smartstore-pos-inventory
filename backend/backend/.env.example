# SmartStore POS Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Server
PORT=4000
NODE_ENV=production

# Database (PostgreSQL)
# Example: postgresql://username:password@host:5432/database_name
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/smartstore_db

# JWT Secret — use a long, random string in production (min 64 chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars

# CORS — Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://your-frontend.com,https://www.your-frontend.com
ALLOWED_ORIGINS=https://your-frontend-domain.com
